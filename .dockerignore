# ВАЖНО: файл лежит в корне, потому что контекст сборки Docker на Fly —
# корень репозитория. `server/.dockerignore` при таком контексте игнорируется
# (Docker читает .dockerignore только из корня контекста), и в образ попадают
# node_modules хоста, собранные под Windows.
#
# Пути относительны корню репозитория.

# ── Зависимости ──────────────────────────────────────────────────────
# Свои node_modules не тащим нигде: их пересоберёт `npm install` в образе.
node_modules
server/node_modules
android
dist

# ── Локальные данные ─────────────────────────────────────────────────
# Кэш треков содержит абсолютные localhost-ссылки; на проде сервер
# восстанавливает их сам по PUBLIC_URL.
server/data

# ── Секреты ──────────────────────────────────────────────────────────
# На Fly они передаются через `fly secrets`, а не запекаются в слои
# (иначе токен бота утёк бы вместе с образом).
.env
.env.*
server/.env
server/.env.*
*.pem
*.key

# ── Фронтенд ─────────────────────────────────────────────────────────
# Бэкенду нужен только server/ — исходники SPA лишь раздувают контекст.
src
public
supabase
index.html
vite.config.ts
capacitor.config.ts
vercel.json
eslint.config.js
tsconfig*.json

# ── Прочее ───────────────────────────────────────────────────────────
npm-debug.log*
*.log
.git
.gitignore
.idea
.vscode
server/tools
server/Dockerfile
server/fly.toml
