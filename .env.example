# ── .env.example (корень фронтенда, Vite) ─────────────────────────────
# Скопируйте в .env.local перед сборкой/деплоем.

# Адрес Telegram-сервера-прокси (localhost разраб. / деплой-URL проде).
# VITE_ — префикс, чтобы Vite пробросил значение во frontend.
VITE_TELEGRAM_SERVER_URL=http://localhost:3001

# ── Будущий Supabase (деплой) ─────────────────────────────────────────
# Не заполнять сейчас — заполним на этапе деплоя, чтобы поднять на backend.
# ЗДЕСЬ НЕ ДЕРЖАТЬ секреты: ключ anon можно публиковать (RLS всё равно защитит).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
