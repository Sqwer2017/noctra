# ── .env.example (корень фронтенда, Vite) ─────────────────────────────
# Скопируйте в .env.local перед сборкой/деплоем.
# На Vercel эти же переменные задаются в Project Settings → Environment Variables.

# ── Адрес бэкенда ────────────────────────────────────────────────────
# Бэкенд задеплоен на Render. Значение уходит в сборку, поэтому после его
# изменения нужен редеплой фронтенда.
VITE_API_URL=https://noctra-ffdm.onrender.com

# Устаревшее имя той же переменной — поддержано для совместимости.
# Используйте VITE_API_URL в новых настройках.
# VITE_TELEGRAM_SERVER_URL=http://localhost:3001

# ── Supabase ─────────────────────────────────────────────────────────
# VITE_SUPABASE_URL работает как переключатель режима хранения:
#
#   пусто                  → локальный режим: всё в localStorage,
#                            сеть не используется;
#   заполнен (URL + ключ)  → облачный режим: профиль, статистика,
#                            избранное и плейлисты синхронизируются с БД.
#
# ВАЖНО ПРО ФОРМАТ URL:
#   Нужен ТОЛЬКО базовый адрес проекта — до домена включительно.
#   Supabase Dashboard в разных местах показывает его по-разному, и легко
#   скопировать вместе с путём API. Клиент сам добавляет /rest/v1/ и /auth/v1/,
#   поэтому лишний путь превращается в /rest/v1/rest/v1/profiles → 404,
#   а вход уходит на /rest/v1/auth/v1/token и не работает вовсе.
#
#     ПРАВИЛЬНО:  https://<project-ref>.supabase.co
#     НЕПРАВИЛЬНО: https://<project-ref>.supabase.co/rest/v1/
#
#   Где взять: Supabase → Project Settings → Data API → Project URL
#   (или Authentication → URL Configuration).
#   Клиент дополнительно подчищает такой URL, но лучше задавать сразу верный.
#
# Ключ: Project Settings → API Keys. Подходит и новый формат
# `sb_publishable_...`, и классический anon JWT.
#
# ЗДЕСЬ НЕ ДЕРЖАТЬ СЕКРЕТЫ: publishable/anon-ключ публичный по задумке
# Supabase, доступ к данным ограничен политиками RLS.
# Service-role / secret-ключ сюда класть НЕЛЬЗЯ.
VITE_SUPABASE_URL=https://ozcxpbdwipezliltfiif.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_CZvZOkOYES4RE2tCiZ-WYA_GagZf18k

# ── Google-авторизация (опционально) ─────────────────────────────────
# OAuth Client ID (тип Web) из Google Cloud Console.
# Нужен для входа одним тапом (Google One Tap, signInWithIdToken).
# Если не задан — кнопка «Войти через Google» автоматически переключится
# на редирект-вариант через Supabase OAuth и продолжит работать.
VITE_GOOGLE_CLIENT_ID=454232821400-gps48gt69adp303cc6tkn6hui4g9ubnq.apps.googleusercontent.com

# ── Что нужно сделать перед первым запуском ──────────────────────────
# 1. Supabase → SQL Editor: выполнить supabase/migrations/001_noctra.sql
#    (добавляет недостающие колонки профиля, триггеры и бакеты Storage).
# 2. Supabase → Authentication → Providers → Google: включить и вставить
#    Client ID / Secret из Google Cloud Console.
#    Authorized redirect URI: https://<project>.supabase.co/auth/v1/callback
# 3. Google Cloud Console → Authorized JavaScript origins: домен Vercel
#    (например https://noctra.vercel.app) — нужен для One Tap.
# 4. Supabase → Authentication → Providers → Anonymous Sign-in: включить,
#    если нужен вход «как гость».
#
# ── Переменные бэкенда (Render) ──────────────────────────────────────
# Задаются в настройках сервиса на Render, а не здесь:
#   TELEGRAM_BOT_TOKEN=...                        (секрет)
#   PUBLIC_URL=https://noctra-ffdm.onrender.com   ← КРИТИЧНО для аудио:
#       без него сервер собирает ссылки на localhost и треки не играют
#   CORS_ORIGINS=https://<ваш-домен>.vercel.app   (через запятую)
