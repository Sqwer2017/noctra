# Контекст сборки — папка server/, поэтому пути здесь относительны ей.
#
# Без этого файла в образ уезжают node_modules хоста (собранные под Windows)
# и локальный кэш треков с абсолютными localhost-ссылками.

node_modules
data
tools

# Секреты в образ не попадают: на Fly они передаются через `fly secrets`,
# а не запекаются в слои (иначе токен бота утёк бы вместе с образом).
.env
.env.*
*.pem
*.key

npm-debug.log*
*.log
.git
.gitignore
Dockerfile
.dockerignore
