# ── server/.env.example ──────────────────────────────────────────────
# Скопируйте в server/.env и заполните. server/.env не коммитится (.gitignore).
#
# Токен бота (получить у @BotFather). Обязателен — без него сервер не стартует.
TELEGRAM_BOT_TOKEN=xxxx:your-bot-token-here
# Порт HTTP-сервера прокси (по умолчанию 3001)
PORT=3001
# Публичный https-URL этого сервера (для webhook на деплое). Локально оставить пустым.
# Пример: https://noctra-api.example.com
PUBLIC_URL=
